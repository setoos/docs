{
  "theme": "mint",
  "name": "20X",
  "logo": {
    "dark": "/logo/dark.png",
    "light": "/logo/light.png"
  },
  "favicon": "/favicon.png",
  "colors": {
    "primary": "#DF4A3A",
    "light": "#E86E5F",
    "dark": "#B83A2D"
  },
  "search": {
    "prompt": "Search documentation or APIs..."
  },
  "seo": {
    "indexing": "all"
  },
  "api": {
    "mdx": {
      "server": "http://localhost:8787/api/v1",
      "auth": {
        "method": "bearer"
      }
    },
    "playground": {
      "display": "interactive",
      "proxy": false
    },
    "params": {
      "expanded": "all"
    },
    "examples": {
      "defaults": "required",
      "languages": [
        "bash",
        "python",
        "javascript"
      ]
    }
  },
